{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ],
    "sourceMap": true,
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "vendor/normify/src/**/*.ts"
  ]
}
