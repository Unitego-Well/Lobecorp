{
  "name": "minecraft-mod-mcp",
  "version": "0.3.0",
  "description": "MCP server bridge & launcher CLI for Minecraft — connect AI tools to Minecraft via Model Context Protocol, launch and manage instances",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "minecraft-mod-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "check:tools": "node scripts/check-effect-tools.mjs",
    "check:runtime": "node scripts/check-effect-tools.mjs --runtime",
    "check:authoring": "node scripts/check-effect-tools.mjs --authoring",
    "reference:effects": "node scripts/create-reference-effects.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "minecraft",
    "mcp",
    "model-context-protocol",
    "ai",
    "automation",
    "forge",
    "fabric",
    "neoforge",
    "launcher",
    "cli"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/langyo/minecraft-mod-mcp",
    "directory": "packages/minecraft-mod-mcp"
  },
  "homepage": "https://github.com/langyo/minecraft-mod-mcp#readme",
  "bugs": {
    "url": "https://github.com/langyo/minecraft-mod-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
